  "space": {
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "5": { "value": "1.5rem" },
    "6": { "value": "2rem" },
    "7": { "value": "3rem" },
    "8": { "value": "4rem" }
  },
  "radius": {
    "sm": { "value": "0.375rem" },
    "md": { "value": "0.75rem" },
    "lg": { "value": "1.25rem" },
    "pill": { "value": "999px" }
  },
  "shadow": {
    "paper": { "value": "0 2px 0 rgba(23, 42, 51, 0.10), 0 8px 22px rgba(23, 42, 51, 0.08)" },
    "raised": { "value": "0 4px 0 rgba(23, 42, 51, 0.12), 0 14px 28px rgba(23, 42, 51, 0.10)" },
    "focus": { "value": "0 0 0 3px #FFFDF7, 0 0 0 6px #006E74" }
  },
  "layout": {
    "reading": { "value": "44rem" },
    "wide": { "value": "76rem" },
