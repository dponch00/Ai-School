    "onDisabled": { "value": "#4D6265" }
  },
  "font": {
    "body": { "value": "'Source Serif 4', Georgia, serif" },
    "display": { "value": "'Fraunces', Georgia, serif" },
    "mono": { "value": "'IBM Plex Mono', ui-monospace, monospace" }
  },
  "fontSize": {
    "xs": { "value": "0.75rem" },
    "sm": { "value": "0.875rem" },
    "base": { "value": "1rem" },
    "reading": { "value": "1.0625rem" },
    "lg": { "value": "1.25rem" },
    "xl": { "value": "1.5rem" },
    "2xl": { "value": "clamp(1.875rem, 6vw, 3rem)" }
  },
  "lineHeight": {
    "tight": { "value": "1.15" },
    "body": { "value": "1.62" },
    "code": { "value": "1.55" }
