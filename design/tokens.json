{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "AI School — Atlas de criterio",
    "version": "1.0.0",
    "source": "design/direcciones/D1-atlas-de-criterio/README.md",
    "contrastMethod": "WCAG 2.2 relative luminance"
  },
  "color": {
    "canvas": { "value": "#F5F0E6" },
