    "onAccent": { "value": "#FFFFFF" },
    "border": { "value": "#778984" },
    "focus": { "value": "#006E74" },
    "selection": { "value": "#DCECF5" },
    "onSelection": { "value": "#123C56" },
    "success": { "value": "#23694D" },
    "successSurface": { "value": "#E5F2EA" },
    "onSuccessSurface": { "value": "#195C42" },
    "warning": { "value": "#865500" },
    "warningSurface": { "value": "#FFF3D6" },
    "danger": { "value": "#A53636" },
    "dangerSurface": { "value": "#FBE9E7" },
    "onDangerSurface": { "value": "#8F2E2E" },
    "info": { "value": "#285A7A" },
    "infoSurface": { "value": "#E5F0F6" },
